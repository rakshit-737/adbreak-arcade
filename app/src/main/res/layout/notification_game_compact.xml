<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/notification_surface"
    android:orientation="vertical"
    android:padding="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    <TextView
        android:id="@+id/notificationCompactTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
         android:layout_height="wrap_content"
         android:textColor="@color/notification_primary_text"
          android:textSize="13sp"
         android:textStyle="bold"
         android:maxLines="1"
         android:ellipsize="end" />
    <TextView
        android:id="@+id/notificationCompactStatus"
        style="@style/NotificationStatus"
        android:layout_width="wrap_content"
         android:layout_height="wrap_content"
          android:layout_marginStart="6dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/notificationCompactScore"
        android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:textColor="@color/notification_accent"
          android:textSize="12sp"
         android:maxLines="1"
         android:ellipsize="end" />
</LinearLayout>
